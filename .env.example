# Dreamina sessionid Cookie value. Keep this file local; never paste it in chat.
DREAMINA_SESSION_ID=
DREAMINA_REGION=US
# Optional: use the complete Cookie header instead of sessionid.
DREAMINA_COOKIE=
# Legacy standalone CLI proxy only. Managed accounts bind proxies in the console.
DREAMINA_PROXY=
# Optional workspace ID. Empty creates without associating an existing workspace.
DREAMINA_WORKSPACE_ID=
# Protect the local API. Used for incoming API calls, distinct from Dreamina cookies.
LOCAL_API_KEY=
# Offline SDK signer uses an isolated Playwright Chromium, never your Chrome profile.
DREAMINA_SIGNING=browser
# Optional SDK state; this is distinct from the sessionid cookie.
DREAMINA_MS_TOKEN=
DREAMINA_DEVICE_ID=
DREAMINA_API_ORIGIN=
# Pairing for the optional real-Chrome extension. Separate from all Dreamina cookies.
CHROME_BRIDGE_KEY=
CHROME_BRIDGE_EXTENSION_ID=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
PLATFORM_ENCRYPTION_KEY=
DATABASE_URL=
ENABLE_RECONCILER=1
WORKER_MODE=native
# Fresh installations require a tested managed proxy before account login/use.
# Existing direct accounts require an explicit false during migration; a broken
# bound proxy never falls back to direct, even when this flag is false.
ACCOUNT_PROXY_REQUIRED=true
PROXY_HEALTH_INTERVAL_SECONDS=600
# Ordered HTTPS IP probes; 1-8 entries, used through the selected proxy.
PROXY_IP_CHECK_URLS=https://api64.ipify.org?format=json,https://api.ipify.org?format=json,https://ipwho.is/
# Legacy single preferred endpoint (only when PROXY_IP_CHECK_URLS is unset):
# PROXY_IP_CHECK_URL=
PROXY_TARGET_CHECK_URL=https://dreamina-api.us.capcut.com/
# HTTPS geography must report the same exit IP and a valid IANA timezone.
PROXY_GEO_CHECK_URL=https://ipwho.is/
LOGIN_MAX_SESSIONS=2
LOGIN_SESSION_TTL=900
LOGIN_BROWSER_HEADLESS=true
LOGIN_AUTO_START_WORKER=true
MANAGED_MAX_WORKERS=4
NATIVE_PREPARE_ATTEMPTS=2
# 1 disables new submissions; 2 allows one extra attempt only with explicit
# upstream non-acceptance + transient-error proof. Unknown/-6 is never retried.
NATIVE_SUBMISSION_ATTEMPTS=2
# Account tabs and upstream in-flight tasks are independent. Existing/new
# account max_inflight remains 1 unless explicitly increased in the console.
NATIVE_MAX_ACCOUNT_INFLIGHT=100
NATIVE_ENTRY_REFRESH_SECONDS=300
# Reload a retained task page after this many completed page uses (1-100).
NATIVE_PAGE_RELOAD_JOBS=20
MANAGED_RESTART_LIMIT=5
MANAGED_RESTART_STABLE_SECONDS=120
MAINTENANCE_RETENTION_DAYS=7
MAINTENANCE_INTERVAL_SECONDS=3600
# Central generated-media/input cleanup is opt-in: 0 disables it, otherwise
# use at least 30 days. Only known old terminal-task files are eligible.
MAINTENANCE_MEDIA_RETENTION_DAYS=0
MAINTENANCE_INPUT_RETENTION_DAYS=0
INTERNAL_API_URL=http://127.0.0.1:8787
LOGIN_BROWSER_ARGS=["--disable-blink-features=AutomationControlled","--no-sandbox","--disable-setuid-sandbox","--disable-web-security","--disable-features=IsolateOrigins,site-per-process","--disable-dev-shm-usage","--disable-accelerated-2d-canvas","--disable-gpu"]
