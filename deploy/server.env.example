# Copy to deploy/server.env on the target server. Never commit the filled file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Deployment-specific bootstrap policy, 8–128; existing administrators are not changed.
ADMIN_PASSWORD_MIN_LENGTH=12
# Generate a Fernet key; keep it together with encrypted database backups.
PLATFORM_ENCRYPTION_KEY=
# Use URL-safe random characters for this password (it is part of DATABASE_URL).
POSTGRES_PASSWORD=
CHROME_BRIDGE_KEY=
CHROME_BRIDGE_EXTENSION_ID=eicelfibiacmlhfepgoiiemfgcbdfafm
# Independent key for any retained legacy/internal endpoints.
LOCAL_API_KEY=
API_PORT=8787
# Keep loopback behind a host reverse proxy; set 0.0.0.0 for an intentional public port.
API_BIND=127.0.0.1
# Public Bearer API only. Use [] to disable, or exact origins e.g. ["https://client.example"].
# Cookies are never enabled; admin/internal/Chrome routes keep their own origin policy.
PUBLIC_API_CORS_ORIGINS=["*"]
# Exact reverse-proxy source IP as seen by the API container; do not use a public wildcard.
FORWARDED_ALLOW_IPS=127.0.0.1

# Integrated Linux browsers use bundled Chromium; no Chrome extension is needed.
WORKER_MODE=native
# Fresh deployments require a tested proxy before adding/logging in accounts.
# For the existing five direct accounts, explicitly use false until proxies are
# verified and bound. This NEVER enables direct fallback for a bound proxy.
ACCOUNT_PROXY_REQUIRED=true
# Probe bound, enabled proxies every 600 seconds (allowed range: 60-86400).
PROXY_HEALTH_INTERVAL_SECONDS=600
# Ordered HTTPS IP probes; 1-8 entries, used through the selected proxy.
PROXY_IP_CHECK_URLS=https://api64.ipify.org?format=json,https://api.ipify.org?format=json,https://ipwho.is/
# Legacy single preferred endpoint (only when PROXY_IP_CHECK_URLS is unset):
# PROXY_IP_CHECK_URL=
PROXY_TARGET_CHECK_URL=https://dreamina-api.us.capcut.com/
# Optional probe override. Binding still requires a known IANA timezone.
PROXY_GEO_CHECK_URL=https://ipwho.is/
# false starts Xvfb inside the API container; the admin login panel is unchanged.
LOGIN_BROWSER_HEADLESS=true
# Simultaneous interactive login panels (1-10), timeout in seconds (60-3600).
LOGIN_MAX_SESSIONS=2
LOGIN_SESSION_TTL=900
# Start this account's managed worker after a successful login.
LOGIN_AUTO_START_WORKER=true
# Maximum resident managed workers (1-100), graceful stop wait (1-60 seconds).
# Login panels have their own limit above and also consume browser resources.
MANAGED_MAX_WORKERS=4
# One browser per account, independent task tabs; per-account setting defaults to 1.
NATIVE_MAX_ACCOUNT_SLOTS=4
# Recycle a retained task page after 20 uses; allowed range 1-100.
NATIVE_PAGE_RELOAD_JOBS=20
# Optional central media/input retention: 0 keeps files (default), otherwise
# at least 30 days. Active/uncertain tasks and unknown references stay protected.
MAINTENANCE_MEDIA_RETENTION_DAYS=0
MAINTENANCE_INPUT_RETENTION_DAYS=0
TASK_QUEUE_TIMEOUT_SECONDS=60
NATIVE_PREPARATION_TIMEOUT_SECONDS=180
NATIVE_SUBMISSION_TIMEOUT_SECONDS=60
NATIVE_GENERATION_TIMEOUT_SECONDS=600
TASK_TOTAL_TIMEOUT_SECONDS=900
NATIVE_PREPARE_ATTEMPTS=2
MANAGED_STOP_TIMEOUT=20
# Browser workers share the API container network; keep this loopback origin.
INTERNAL_API_URL=http://127.0.0.1:8787
LOGIN_BROWSER_ARGS=["--disable-blink-features=AutomationControlled","--no-sandbox","--disable-setuid-sandbox","--disable-web-security","--disable-features=IsolateOrigins,site-per-process","--disable-dev-shm-usage","--disable-accelerated-2d-canvas","--disable-gpu"]
