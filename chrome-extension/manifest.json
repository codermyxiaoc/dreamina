{
  "manifest_version": 3,
  "name": "Dreamina Local Chrome Bridge",
  "version": "0.4.1",
  "minimum_chrome_version": "120",
  "description": "Connect one signed-in Dreamina tab to your local generation queue.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://dreamina.capcut.com/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dreamina 本地桥接"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": ""
}
